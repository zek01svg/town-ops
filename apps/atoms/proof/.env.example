PORT=5007
DATABASE_URL=postgresql://townops:townops@localhost:5432/townops_proof
S3_ENDPOINT=http://localhost:9000
# Public base where objects are served. MinIO path-style includes the bucket;
# for R2 this is the bucket's public r2.dev / custom domain (no bucket segment).
S3_PUBLIC_URL=http://localhost:9000/proofs
S3_ACCESS_KEY_ID=townops
S3_SECRET_ACCESS_KEY=townopssecret
S3_BUCKET=proofs
S3_REGION=us-east-1
OTEL_EXPORTER_OTLP_ENDPOINT=your-otel-endpoint
OTEL_EXPORTER_OTLP_HEADERS=your-otel-headers

# Shared secret the Gateway and Worker present on private atom routes.
# Minimum 32 characters; must match the value the Worker and Gateway use.
WORKER_SERVICE_TOKEN=change-me-shared-worker-service-token

SENTRY_BACKEND_DSN=your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=1.0
