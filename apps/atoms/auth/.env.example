PORT=5001
DATABASE_URL=postgresql://townops:townops@localhost:5432/townops_auth
OTEL_EXPORTER_OTLP_ENDPOINT=your-otel-endpoint
OTEL_EXPORTER_OTLP_HEADERS=your-otel-headers

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL="http://localhost:5001"
# Optional — only if Google OAuth is enabled
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional — comma-separated deployed frontend origins trusted in addition to
# the localhost defaults (3001-3003 and 5173-5175).
# AUTH_TRUSTED_ORIGINS=https://officer.example.run.app,https://resident.example.run.app

SENTRY_BACKEND_DSN=your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=1.0
