PORT=5006
DATABASE_URL=postgresql://townops:townops@localhost:5432/townops_metrics

# Shared secret the Gateway and Worker present on private atom routes.
# Minimum 32 characters; must match the value the Worker and Gateway use.
WORKER_SERVICE_TOKEN=change-me-shared-worker-service-token

SENTRY_BACKEND_DSN=your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=1.0
